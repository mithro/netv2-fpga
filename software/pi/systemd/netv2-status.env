# Environment for netv2-status.service. Copy to /etc/netv2/netv2-status.env.
#
# UART carrying the SoC console/telemetry:
#   Pi 3B+ : /dev/ttyS0   (needs enable_uart=1 in config.txt)
#   Pi 5   : /dev/ttyAMA0
NETV2_STATUS_UART=/dev/ttyS0
NETV2_STATUS_BAUD=115200

# HTTP endpoint MMM-json-feed polls. Loopback only by design.
NETV2_STATUS_HTTP_HOST=127.0.0.1
NETV2_STATUS_HTTP_PORT=6502

# Minimum line length before a buffer is treated as a telemetry record.
# The 2019 reporter used 200 ("expect large JSON record").
NETV2_STATUS_MIN_LEN=200
